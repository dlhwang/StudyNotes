# 설정 예시. 복사해서 .env 로 쓴다. 비밀값은 여기 넣지 않는다(실제 값은 .env 에만).
# Agent 키는 src/study_notes/config.py, BE 키는 src/notes_api/config.py, 화면 키는 src/notes_ui/config.py.

# ══ Agent (src/study_notes) ════════════════════════════════════════════════════
STUDY_NOTES_ENV=local
STUDY_NOTES_LOG_LEVEL=INFO

# BE 조회: fake(가짜 BE, 시험·평가용 기본) | http(학습 노트 BE)
# - BE가 Agent를 같은 프로세스로 돌릴 때(NOTES_API_AGENT_MODE=inprocess)는 이 값과 상관없이 같은 BE를 부른다.
# - Aegra 위에서 돌릴 때는 http로 두고 BE 주소를 적는다.
STUDY_NOTES_BE__MODE=fake
STUDY_NOTES_BE__BASE_URL=http://127.0.0.1:8000
STUDY_NOTES_BE__PATH_PREFIX=/internal/agent

# 모델: fake(가짜, 기본 — 모든 답이 규칙 답) | litellm
STUDY_NOTES_LLM__MODE=fake
# 역할 키 → 모델 ID (litellm 형식). 공급자 키(OPENAI_API_KEY 등)는 .env에만
# STUDY_NOTES_LLM__MODELS={"router": "openai/gpt-4o-mini", "worker": "openai/gpt-4o-mini", "judge": "openai/gpt-4o-mini"}

# 인증(Aegra): dev | trusted_be
STUDY_NOTES_AUTH__MODE=dev
# STUDY_NOTES_AUTH__SHARED_KEY=

# 실행 기록: log(JSON 로그만, 기본) | postgres(아래 DB의 AGENT_DB_SCHEMA에 남김)
STUDY_NOTES_RECORDER=log

# ══ BE (src/notes_api) ═════════════════════════════════════════════════════════
NOTES_API_DB_PATH=data/notes.db
NOTES_API_CHROMA_DIR=data/chroma
# 임베딩: hash(모델 없이, 기본) | litellm(모델 필요. 바꾸면 설정 화면에서 '전체 다시 적재')
NOTES_API_EMBEDDING_MODE=hash
# NOTES_API_EMBEDDING_MODEL=openai/text-embedding-3-small
NOTES_API_SEED_DEMO=true
# Agent 실행: inprocess(BE 안, PostgreSQL 불필요) | aegra(떠 있는 Aegra 서버)
NOTES_API_AGENT_MODE=inprocess
NOTES_API_AEGRA_URL=http://127.0.0.1:2026

# ══ 화면 (src/notes_ui, app/) ══════════════════════════════════════════════════
NOTES_UI_API_URL=http://127.0.0.1:8000

# ══ MCP 서버 (src/notes_mcp) ═══════════════════════════════════════════════════
NOTES_MCP_BE_URL=http://127.0.0.1:8000

# ══ PostgreSQL (Aegra를 쓸 때만) ════════════════════════════════════════════════
# Agent와 Aegra가 같은 값을 읽는다. DATABASE_URL은 두지 않는다(있으면 Aegra가 그것을 먼저 쓴다).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# PGSSLMODE=require
# 우리 테이블(실행 기록·평가)을 둘 스키마
AGENT_DB_SCHEMA=agent

# ── Aegra 서버 (docs.aegra.dev/reference/environment-variables) ──────────────
# REDIS_BROKER_ENABLED=false
