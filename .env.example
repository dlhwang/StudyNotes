# 설정 예시. 복사해서 .env 로 쓴다. 비밀값은 여기 넣지 않는다(실제 값은 .env 에만).
# 모든 키는 src/study_notes/config.py 에 정의돼 있다.

STUDY_NOTES_ENV=local
STUDY_NOTES_LOG_LEVEL=INFO

# BE: fake(가짜 BE, 기본) | http
STUDY_NOTES_BE__MODE=fake
STUDY_NOTES_BE__BASE_URL=http://localhost:8080
STUDY_NOTES_BE__PATH_PREFIX=/internal/agent
# STUDY_NOTES_BE__SERVICE_TOKEN=          # 예약 실행용 읽기 전용 서비스 계정

# 모델: fake(가짜, 기본 — 모든 답이 규칙 답) | litellm
STUDY_NOTES_LLM__MODE=fake
# 역할 키 → 모델 ID (litellm 형식)
# STUDY_NOTES_LLM__MODELS={"router": "...", "worker": "...", "judge": "..."}

# 인증: dev | trusted_be
STUDY_NOTES_AUTH__MODE=dev
# STUDY_NOTES_AUTH__SHARED_KEY=

# ── DB (PostgreSQL) ─────────────────────────────────────────────────────────────
# ai-agent와 Aegra가 같은 값을 읽는다. DATABASE_URL은 두지 않는다(있으면 Aegra가 그것을 먼저 쓴다).
# 서버 주소·포트·DB·계정은 팀이 정한 개발 DB 값으로 바꾼다. 비밀번호는 .env 에만 적는다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# PGSSLMODE=require        # ai-agent 쪽 접속에 쓴다. Aegra 쪽 TLS 설정은 확인 안 함
# 우리 테이블(실행 기록·평가)을 둘 스키마
AGENT_DB_SCHEMA=agent

# 실행 기록: log(JSON 로그만, 기본) | postgres(위 DB의 AGENT_DB_SCHEMA에 남김)
STUDY_NOTES_RECORDER=log

# ── Aegra 서버 (docs.aegra.dev/reference/environment-variables) ──────────────
# REDIS_BROKER_ENABLED=false
